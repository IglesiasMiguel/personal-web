---
import type { HomeContent, HomeLang } from '@/content/home';
import DotField from '@/components/DotField';
import FieldMotionController from '@/components/field/FieldMotionController';
import FieldTopNav from '@/components/field/FieldTopNav.astro';
import FieldHero from '@/components/field/FieldHero.astro';
import FieldPanel from '@/components/field/FieldPanel.astro';
import FeaturedProject from '@/components/field/FeaturedProject.astro';
import SplitProjectRow from '@/components/field/SplitProjectRow.astro';
import ArchiveStrip from '@/components/field/ArchiveStrip.astro';
import ExperienceTimeline from '@/components/field/ExperienceTimeline.astro';
import FieldContact from '@/components/field/FieldContact.astro';

interface Props {
  lang: HomeLang;
  content: HomeContent;
}

const { lang, content } = Astro.props;
---

<div id="field-page" class="field-page">
  <div class="field-background-shell" aria-hidden="true">
    <DotField
      client:load
      dotRadius={1.5}
      dotSpacing={14}
      cursorRadius={500}
      glowRadius={160}
      cursorForce={0.1}
      bulgeOnly={true}
      bulgeStrength={67}
      sparkle={false}
      waveAmplitude={0}
      gradientFrom="rgba(85, 216, 222, 0.52)"
      gradientTo="rgba(166, 237, 239, 0.3)"
      glowColor="rgba(9, 16, 25, 0.92)"
    />
  </div>
  <FieldMotionController client:load />
  <div class="field-page-overlay" aria-hidden="true"></div>
  <div class="field-page-content">
    <FieldTopNav brand={content.brand} nav={content.nav} lang={lang} />
    <main>
      <FieldHero content={content.hero} />

      <section class="field-section" id="about" data-field-reveal style="--field-delay: 60ms;">
        <div class="field-container">
          <FieldPanel label={content.about.label}>
            <p class="field-about-copy">{content.about.body}</p>
          </FieldPanel>
        </div>
      </section>

      <section class="field-section" data-field-reveal style="--field-delay: 75ms;">
        <div class="field-container">
          <div class="field-section-label">{content.projects.label}</div>
        </div>
      </section>

      <FeaturedProject project={content.projects.featured} />
      <SplitProjectRow project={content.projects.healthtech} />
      <SplitProjectRow project={content.projects.pharmatech} reverse={true} />
      <ArchiveStrip archive={content.projects.archive} />
      <ExperienceTimeline experience={content.experience} />
      <FieldContact contact={content.contact} />
    </main>
  </div>
</div>
