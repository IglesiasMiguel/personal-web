---
interface Props {
  contact: {
    label: string;
    heading: string;
    footer: string;
    links: Array<{
      label: string;
      href: string;
      subtitle: string;
      accent?: boolean;
    }>;
  };
}

const { contact } = Astro.props;

const iconMap = {
  LinkedIn: `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.94 8.5H3.56V20h3.38V8.5Zm.22-3.55a1.96 1.96 0 1 0-3.92 0 1.96 1.96 0 0 0 3.92 0ZM20.44 13.04c0-3.47-1.85-5.08-4.31-5.08-1.99 0-2.88 1.09-3.38 1.86V8.5H9.38c.04.88 0 11.5 0 11.5h3.37v-6.42c0-.34.03-.68.13-.92.27-.67.88-1.37 1.9-1.37 1.35 0 1.89 1.03 1.89 2.54V20H20v-7.0c0 .02.44.04.44.04Z"/></svg>`,
  GitHub: `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .5A12 12 0 0 0 8.2 23.9c.6.12.82-.26.82-.58v-2.04c-3.34.73-4.04-1.42-4.04-1.42-.55-1.38-1.33-1.74-1.33-1.74-1.09-.74.08-.73.08-.73 1.2.08 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.48 1 .11-.78.42-1.31.76-1.61-2.66-.3-5.46-1.33-5.46-5.93 0-1.31.47-2.39 1.23-3.23-.13-.3-.54-1.52.12-3.17 0 0 1-.32 3.3 1.23a11.43 11.43 0 0 1 6 0c2.28-1.55 3.28-1.23 3.28-1.23.66 1.65.25 2.87.12 3.17.77.84 1.23 1.92 1.23 3.23 0 4.61-2.8 5.62-5.47 5.92.43.37.82 1.11.82 2.24v3.31c0 .32.21.7.83.58A12 12 0 0 0 12 .5Z"/></svg>`,
  Instagram: `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M7.75 2h8.5A5.76 5.76 0 0 1 22 7.75v8.5A5.76 5.76 0 0 1 16.25 22h-8.5A5.76 5.76 0 0 1 2 16.25v-8.5A5.76 5.76 0 0 1 7.75 2Zm-.2 1.8A3.95 3.95 0 0 0 3.8 7.55v8.9a3.95 3.95 0 0 0 3.75 3.75h8.9a3.95 3.95 0 0 0 3.75-3.75v-8.9a3.95 3.95 0 0 0-3.75-3.75h-8.9Zm8.96 1.35a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2ZM12 6.86A5.14 5.14 0 1 1 6.86 12 5.15 5.15 0 0 1 12 6.86Zm0 1.8A3.34 3.34 0 1 0 15.34 12 3.35 3.35 0 0 0 12 8.66Z"/></svg>`,
} as const;
---

<section
  class="field-section field-contact"
  id="contact"
  data-field-reveal
  style="--field-delay: 420ms;"
>
  <div class="field-container field-contact-inner">
    <h2 class="field-contact-title">{contact.heading}</h2>
    <div class="field-contact-links">
      {
        contact.links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            class:list={['field-contact-link', link.accent && 'is-accent']}
          >
            <span
              class="field-contact-link-icon"
              set:html={iconMap[link.label as keyof typeof iconMap] ?? ''}
            />
            <span class="field-contact-link-copy">
              <strong>{link.label}</strong>
              <span>{link.subtitle}</span>
            </span>
            <span class="field-contact-link-arrow" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 17L17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
    <p class="field-contact-footer">{contact.footer}</p>
  </div>
</section>
