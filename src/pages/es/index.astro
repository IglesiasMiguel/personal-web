---
import Layout from '@/layouts/Layout.astro';
import type { PageMeta } from '@/lib/constants';
import FieldHome from '@/components/field/FieldHome.astro';
import { getHomeContent } from '@/content/home';

const meta: PageMeta = {
  title: 'Miguel Iglesias | Portafolio Frontend y Agentes IA',
  description:
    'Portafolio de Miguel Iglesias enfocado en desarrollo frontend, agentes de IA, automatización y ejecución orientada a producto.',
};
const lang = 'es';
---

<Layout {...meta}>
  <FieldHome lang={lang} content={getHomeContent(lang)} />
</Layout>
