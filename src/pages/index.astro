---
import Layout from '@/layouts/Layout.astro';
import type { PageMeta } from '@/lib/constants';
import FieldHome from '@/components/field/FieldHome.astro';
import { getHomeContent } from '@/content/home';

const meta: PageMeta = {
  title: 'Miguel Iglesias | Frontend and AI Agent Developer',
  description:
    'Portfolio of Miguel Iglesias, focused on frontend development, AI agents, automation systems, and product-minded implementation.',
};
const lang = 'en';
---

<Layout {...meta}>
  <FieldHome lang={lang} content={getHomeContent(lang)} />
</Layout>
